# Prevent execution of uploaded scripts inside /uploads on cPanel
Options -Indexes
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
